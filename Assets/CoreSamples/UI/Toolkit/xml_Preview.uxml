        <NiqonNO.UI.NOColorPicker saturation="1" label="Color Picker" picker-plot-drawer="project://database/Assets/_UIToolkit/Shaders/shg_NO_UI_ColorWheel.shadergraph?fileID=-6465566751694194690&amp;guid=ee7f4fcd1389943458f95f466a449083&amp;type=3#Shader Graphs/shg_NO_UI_ColorWheel" edges-offset="0.1,0.95" picker-plot-type="HueValue_Saturation" name="color-picker-sample" picker-slider-drawer="project://database/Assets/_UIToolkit/Shaders/shg_NO_UI_ColorSlider.shadergraph?fileID=-6465566751694194690&amp;guid=e02609f68bfe822408658f3b0a297cc2&amp;type=3#Shader Graphs/shg_NO_UI_ColorSlider" data-source-type="NiqonNO.UI.MVVM.NOColorPickerViewModel, NiqonNO.UI" value="0,1,-0.1" color-value="rgb(0, 0, 0)" style="height: 422px; flex-grow: 1; flex-direction: column;">
            <Bindings>
                <ui:DataBinding property="PickerPlotType" data-source-path="ColorPickerType" binding-mode="ToTarget"/>
                <ui:DataBinding property="ColorValue" data-source-path="Value" binding-mode="TwoWay"/>
