<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_UIToolkit/Resources/uss_Color%20Picker.uss?fileID=7433441132597879392&amp;guid=e07f788a9f27cb44a98d9eb6bcf91977&amp;type=3#uss_Color Picker"/>
    <Style src="project://database/Assets/CoreSamples/UI/Toolkit/uss_Preview.uss?fileID=7433441132597879392&amp;guid=5f0f76ff97607d046858e8cf51782b98&amp;type=3#uss_Preview"/>
    <ui:VisualElement name="VisualElement" data-source-type="NiqonNO.Samples.NOSampleController, Assembly-CSharp" style="background-color: rgb(26, 26, 26); padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(193, 149, 88); border-right-color: rgb(193, 149, 88); border-top-color: rgb(193, 149, 88); border-bottom-color: rgb(193, 149, 88); height: 980px; width: 570px; align-self: flex-start; flex-direction: column; top: 5%; left: 50px; position: absolute;">
        <NiqonNO.UI.NOTernarySlider high-value="100" round-to-int="false" value="48.5,34,48.5" label="Ternary" name="ternary-sample" data-source-type="NiqonNO.UI.MVVM.NOTernaryViewModel, NiqonNO.UI" style="overflow: visible; flex-direction: column;">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Value" binding-mode="TwoWay"/>
            </Bindings>
        </NiqonNO.UI.NOTernarySlider>
        <ui:Slider label="Slider" value="42" high-value="100" show-input-field="true" name="slider-sample-A" data-source-type="NiqonNO.UI.MVVM.NOSliderViewModel, NiqonNO.UI" style="flex-direction: column; flex-grow: 0;">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Value" binding-mode="TwoWay"/>
            </Bindings>
        </ui:Slider>
        <ui:Slider value="42" high-value="100" show-input-field="true" name="slider-sample-B" label="Slider" data-source-type="NiqonNO.UI.MVVM.NOSliderViewModel, NiqonNO.UI" style="flex-direction: column; flex-grow: 0;">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Value"/>
            </Bindings>
        </ui:Slider>
        <NiqonNO.UI.NOToggleSelector mode="Horizontal" item-template="project://database/Assets/CoreSamples/UI/Toolkit/xml_Toggle%20Tile.uxml?fileID=9197481963319205126&amp;guid=610c0c0cfb6f1874e93b9601e4ade49a&amp;type=3#xml_Toggle Tile" auto-scroll-ease="OutElastic" auto-scroll-duration="1" scroll-deceleration-duration="0.3" direction="Horizontal" selected-index="0" tile-size="100%" name="selector-sample-A" style="display: flex; flex-grow: 1;">
            <Bindings>
                <ui:DataBinding property="CollectionState" data-source-path="ToggleSelectorState" binding-mode="TwoWay"/>
                <ui:DataBinding property="SelectedIndex" data-source-path="CollectionSelectionAValue" binding-mode="TwoWay"/>
                <ui:DataBinding property="SourceCollection" data-source-path="CollectionAValue" binding-mode="TwoWay"/>
            </Bindings>
        </NiqonNO.UI.NOToggleSelector>
        <NiqonNO.UI.NOToggleSelector mode="Horizontal" item-template="project://database/Assets/CoreSamples/UI/Toolkit/xml_Toggle%20Tile.uxml?fileID=9197481963319205126&amp;guid=610c0c0cfb6f1874e93b9601e4ade49a&amp;type=3#xml_Toggle Tile" auto-scroll-ease="OutElastic" auto-scroll-duration="1" scroll-deceleration-duration="0.3" direction="Horizontal" selected-index="0" tile-size="100%" name="selector-sample-B" style="display: flex; flex-grow: 0.25;">
            <Bindings>
                <ui:DataBinding property="CollectionState" data-source-path="ToggleSelectorState" binding-mode="TwoWay"/>
                <ui:DataBinding property="SelectedIndex" data-source-path="CollectionSelectionBValue" binding-mode="TwoWay"/>
                <ui:DataBinding property="SourceCollection" data-source-path="CollectionBValue" binding-mode="TwoWay"/>
