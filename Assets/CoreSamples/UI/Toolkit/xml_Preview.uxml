    <ui:VisualElement name="VisualElement" data-source-type="NiqonNO.Samples.NOSampleController, Assembly-CSharp" style="background-color: rgb(26, 26, 26); padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(193, 149, 88); border-right-color: rgb(193, 149, 88); border-top-color: rgb(193, 149, 88); border-bottom-color: rgb(193, 149, 88); height: 980px; width: 570px; align-self: flex-start; flex-direction: column; top: 5%; left: 635px; position: absolute;">
        <NiqonNO.UI.NOQuaternarySlider name="quaternary-sample" value="25,32.66667,32.66667,32.66667" data-source-type="NiqonNO.UI.MVVM.NOQuaternaryViewModel, NiqonNO.UI" label="Quaternary" style="flex-direction: column;">
            <Bindings>
